#=============================================================================
#
# file :        Makefile
#
# description : Makefile to generate a TANGO device server.
#
# project :     Automation1
#
#=============================================================================
#                This file is generated by POGO
#        (Program Obviously used to Generate tango Object)
#=============================================================================
#
# Paths the user may need to modify:
#
# MAKE_ENV is the path to find the common environment to build the project
#
# The /usr/local/tango/ part of this path depends on where tango is installed.
# Commonly this will be /usr/local/tango/ or /usr/local/
#
#MAKE_ENV = /usr/local/tango
MAKE_ENV = $(TANGO_HOME)/share/pogo/preferences
#
# The libraries and header files for Automation1 should have been provided with
# Automation1 controllers.
#
# A1LIB_HOME is the path to the Automation1 libraries, such as libautomation1c.so
# and libautomation1compiler.so
#
A1LIB_HOME ?= /usr/local/lib/
#
# A1HEADER_HOME is the path to the Automation1 header files, such as 
# automation1.h and files of name format automation1____.h
#
A1HEADER_HOME ?= /usr/local/include/Automation1/
#
#=============================================================================
# PACKAGE_NAME is the name of the library/device/exe you want to build
#
PACKAGE_NAME = Automation1
MAJOR_VERS   = 1
MINOR_VERS   = 0
RELEASE      = Release_$(MAJOR_VERS)_$(MINOR_VERS)

# #=============================================================================
# # RELEASE_TYPE
# # - DEBUG     : debug symbols - no optimization
# # - OPTIMIZED : no debug symbols - optimization level set to O2
# #-----------------------------------------------------------------------------
RELEASE_TYPE = DEBUG

#=============================================================================
# OUTPUT_TYPE can be one of the following :
#   - 'STATIC_LIB' for a static library (.a)
#   - 'SHARED_LIB' for a dynamic library (.so)
#   - 'DEVICE' for a device server (will automatically include and link
#            with Tango dependencies)
#   - 'SIMPLE_EXE' for an executable with no dependency (for exemple the test tool
#                of a library with no Tango dependencies)
#
OUTPUT_TYPE = DEVICE

#=============================================================================
# OUTPUT_DIR  is the directory which contains the build result.
# if not set, the standard location is :
#	- ./lib   if OUTPUT_TYPE is SHARED_LIB or STATIC_LIB
#	- ./bin for others
#

# OUTPUT_DIR = /usr/local/bin
OUTPUT_DIR = ./bin

OBJ_DIR = ./obj

#=============================================================================
# Tango Class list used by project
#
# A1BRIDGE_CLASS = A1Bridge
A1BRIDGE_HOME  = ./A1Bridge

A1AXIS_CLASS = A1Axis
A1AXIS_HOME  = ./A1Axis

A1CONTROLLER_CLASS = A1Controller
A1CONTROLLER_HOME  = ./A1Controller



#=============================================================================
# INC_DIR_USER is the list of all include path needed by your sources
#   - for a device server, tango dependencies are automatically appended
#   - '-I ../include' and '-I .' are automatically appended in all cases
#
INC_DIR_USER= -I . \
              -I $(A1BRIDGE_HOME) \
              -I $(A1HEADER_HOME) \
              -I $(A1AXIS_HOME) \
              -I $(A1CONTROLLER_HOME)

#=============================================================================
# LIB_DIR_USER is the list of user library directories
#   - for a device server, tango libraries directories are automatically appended
#   - '-L ../lib' is automatically appended in all cases
#

LIB_DIR_USER= -L $(A1LIB_HOME)

#=============================================================================
# LFLAGS_USR is the list of user link flags
#   - for a device server, tango libraries directories are automatically appended
#   - '-ldl -lpthread' is automatically appended in all cases
#
# !!! ATTENTION !!!
# Be aware that the order matters. 
# For example if you must link with libA, and if libA depends itself on libB
# you must use '-lA -lB' in this order as link flags, otherwise you will get
# 'undefined reference' errors
#
LFLAGS_USR+= -lautomation1compiler -lautomation1c 


#=============================================================================
# CXXFLAGS_USR lists the compilation flags specific for your library/device/exe
# This is the place where to put your compile-time macros using '-Dmy_macro'
#
# -DACE_HAS_EXCEPTIONS -D__ACE_INLINE__ for ACE
#
CXXFLAGS_USR+= -Wall
#CXXFLAGS_USR = -g


#=============================================================================
# TANGO_REQUIRED 
# - TRUE  : your project depends on TANGO
# - FALSE : your project does not depend on TANGO
#-----------------------------------------------------------------------------
# - NOTE : if PROJECT_TYPE is set to DEVICE, TANGO will be auto. added
#-----------------------------------------------------------------------------  
TANGO_REQUIRED = TRUE



#=============================================================================
#	include Standard TANGO compilation options
#
include $(MAKE_ENV)/tango.opt

#=============================================================================
#	POST_PROCESSING: action to be done after normal make.
#	e.g.:  change executable file name, .....
#POST_PROCESSING = \
#	mv bin/$(BIN_DIR)/$(PACKAGE_NAME) bin/$(BIN_DIR)/$(PACKAGE_NAME)_DS

#=============================================================================
# SVC_OBJS is the list of all objects needed to make the output
#
SVC_OBJS =  $(SVC_A1AXIS_OBJS) \
            $(SVC_A1CONTROLLER_OBJS) \
			$(SVC_A1BRIDGE_OBJS) \
            $(OBJDIR)/MultiClassesFactory.o \
            $(OBJDIR)/main.o \
			

#------------  Object files for A1Communication class  ------------
SVC_A1BRIDGE_OBJS = \
		$(OBJDIR)/A1Bridge.o \
		$(OBJDIR)/A1Communication.o \
		$(OBJDIR)/A1Simulation.o \
		$(OBJDIR)/A1SimulatedAxis.o

#------------  Object files for A1Axis class  ------------
SVC_A1AXIS_OBJS = \
		$(OBJDIR)/A1Axis.o \
		$(OBJDIR)/A1AxisClass.o \
		$(OBJDIR)/A1AxisStateMachine.o

#------------  Object files for A1Controller class  ------------
SVC_A1CONTROLLER_OBJS = \
		$(OBJDIR)/A1Controller.o \
		$(OBJDIR)/A1ControllerClass.o \
		$(OBJDIR)/A1ControllerStateMachine.o


#=============================================================================
#	include common targets
#
include $(MAKE_ENV)/common_target.opt

#=============================================================================
# Following are dependancies of the classes used by project
#
#------------  Object files dependencies for A1Communication class  ------------
A1BRIDGE_INCLUDES = \
		A1Defines.h \
		A1Bridge/A1Bridge.h \
		A1Bridge/A1Communication.h \
		A1Bridge/A1SimulatedAxis.h \
		A1Bridge/A1Simulation.h

$(OBJDIR)/A1Bridge.o:  $(A1BRIDGE_HOME)/A1Bridge.cpp $(A1BRIDGE_INCLUDES)
	$(CXX) $(CXXFLAGS) $(CXXFLAGS_USR) -c $< -o $(OBJDIR)/A1Bridge.o
$(OBJDIR)/A1Communication.o:  $(A1BRIDGE_HOME)/A1Communication.cpp $(A1BRIDGE_INCLUDES)
	$(CXX) $(CXXFLAGS) $(CXXFLAGS_USR) -c $< -o $(OBJDIR)/A1Communication.o
$(OBJDIR)/A1Simulation.o:  $(A1BRIDGE_HOME)/A1Simulation.cpp $(A1BRIDGE_INCLUDES)
	$(CXX) $(CXXFLAGS) $(CXXFLAGS_USR) -c $< -o $(OBJDIR)/A1Simulation.o
$(OBJDIR)/A1SimulatedAxis.o:  $(A1BRIDGE_HOME)/A1SimulatedAxis.cpp $(A1BRIDGE_INCLUDES)
	$(CXX) $(CXXFLAGS) $(CXXFLAGS_USR) -c $< -o $(OBJDIR)/A1SimulatedAxis.o

#------------  Object files dependencies for A1Axis class  ------------
A1AXIS_INCLUDES = \
		A1Defines.h \
		$(A1AXIS_HOME)/A1Axis.h \
		$(A1AXIS_HOME)/A1AxisClass.h \
		A1Bridge/A1Bridge.h

$(OBJDIR)/A1Axis.o:  $(A1AXIS_HOME)/A1Axis.cpp $(A1AXIS_INCLUDES)
	$(CXX) $(CXXFLAGS) $(CXXFLAGS_USR) -c $< -o $(OBJDIR)/A1Axis.o
$(OBJDIR)/A1AxisClass.o:  $(A1AXIS_HOME)/A1AxisClass.cpp $(A1AXIS_INCLUDES)
	$(CXX) $(CXXFLAGS) $(CXXFLAGS_USR) -c $< -o $(OBJDIR)/A1AxisClass.o
$(OBJDIR)/A1AxisStateMachine.o:  $(A1AXIS_HOME)/A1AxisStateMachine.cpp $(A1AXIS_INCLUDES)
	$(CXX) $(CXXFLAGS) $(CXXFLAGS_USR) -c $< -o $(OBJDIR)/A1AxisStateMachine.o

#------------  Object files dependencies for A1Controller class  ------------
A1CONTROLLER_INCLUDES = \
		A1Defines.h \
		$(A1CONTROLLER_HOME)/A1Controller.h \
		$(A1CONTROLLER_HOME)/A1ControllerClass.h \
		A1Bridge/A1Bridge.h

$(OBJDIR)/A1Controller.o:  $(A1CONTROLLER_HOME)/A1Controller.cpp $(A1CONTROLLER_INCLUDES)
	$(CXX) $(CXXFLAGS) $(CXXFLAGS_USR) -c $< -o $(OBJDIR)/A1Controller.o
$(OBJDIR)/A1ControllerClass.o:  $(A1CONTROLLER_HOME)/A1ControllerClass.cpp $(A1CONTROLLER_INCLUDES)
	$(CXX) $(CXXFLAGS) $(CXXFLAGS_USR) -c $< -o $(OBJDIR)/A1ControllerClass.o
$(OBJDIR)/A1ControllerStateMachine.o:  $(A1CONTROLLER_HOME)/A1ControllerStateMachine.cpp $(A1CONTROLLER_INCLUDES)
	$(CXX) $(CXXFLAGS) $(CXXFLAGS_USR) -c $< -o $(OBJDIR)/A1ControllerStateMachine.o



finalbuild:
		@echo "Creating executable $(OUTPUT_DIR)/$(PROJECT_NAME) ..."
		$(CXX) -Wl,-rpath=$(A1LIB_HOME) $(SVC_OBJS) $(LDFLAGS) -o $(OUTPUT_DIR)/$(PROJECT_NAME)
		$(POST_PROCESSING)

all:finalbuild
